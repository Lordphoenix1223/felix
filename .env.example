# Copy this file to .env or configure the variables in the Felix menu.
# Felix is intentionally BYOK. Never commit real credentials.

# NVIDIA NIM API Catalog
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
# Optional faster multimodal model for simple questions.
NVIDIA_FAST_MODEL=

# Optional Composio v3.1 project API key.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=felix-local-user
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1

# Optional local/project context file. Markdown is accepted.
FELIX_CONTEXT_FILE=

# Optional local neural speech. The default is Apple speech for low latency.
# Use only after a persistent Kokoro backend is configured and tested.
FELIX_TTS_ENGINE=system
